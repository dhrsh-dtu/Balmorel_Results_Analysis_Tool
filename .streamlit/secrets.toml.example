# Streamlit secrets template.
#
# v0.1 does not require any secrets — access control is handled by the
# Streamlit Cloud "Viewer access" allowlist (email-based).
#
# Add the real secrets.toml to Streamlit Cloud via:
#   App settings → Secrets → paste TOML content
# DO NOT commit secrets.toml to git (it's already in .gitignore).

# Example: if you ever add a feature that needs an API token:
#
# [some_api]
# token = "your-token-here"
